# ==============================================================================
# SANGAM B2B TravelTech SaaS - Root Environment Configuration Example
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# Database Configuration (PostgreSQL / Neon compatible)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sangam?schema=public

# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super-secure-sangam-jwt-secret-replace-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Intelligence Service (Python FastAPI)
INTELLIGENCE_SERVICE_URL=http://localhost:8000

# Client Configuration
VITE_API_URL=http://localhost:4000/api/v1
